<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/RuxTheme"
        android:hasCode="false">

        <!--
          `NativeActivity` is the framework's own activity for an application whose whole body is a
          native library. It needs no Java and no Kotlin and no Maven dependency, which is why it is
          used here rather than `GameActivity` — and the cost is that `eframe` cannot enable AccessKit
          with it, so this build has no screen reader support. That is written down in the README beside
          the reason.
        -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:exported="true">

            <!-- Which library to load. It defaults to `main`; this crate's library is `rux_mobile`, so
                 the two are made to agree here and in mobile/app/Cargo.toml. -->
            <meta-data android:name="android.app.lib_name" android:value="rux_mobile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
