<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/RuxTheme">

        <!--
          `MainActivity` is a `RuxActivity`, which is a `GameActivity`: the Jetpack activity for an
          application whose body is a native library. It replaced the framework's `NativeActivity` so the
          application can have a soft keyboard, AccessKit and the real window insets, all three of which
          need a few lines of Kotlin. `mobile/android/README.md` records the change.

          `adjustNothing`: the keyboard covers the window rather than shrinking it, and `rux` moves the
          focused field above it using the keyboard height `RuxActivity` reports.
        -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|density|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">

            <!-- Which library to load. GameActivity reads the same meta-data NativeActivity did. -->
            <meta-data android:name="android.app.lib_name" android:value="rux_mobile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
