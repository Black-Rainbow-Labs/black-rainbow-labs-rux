<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The application draws every pixel of its own window, including the background behind the notch and
      the home indicator, so the system must not draw a title bar or an action bar over it.
      `Theme.DeviceDefault.NoActionBar` is the framework's own, so there is no appcompat dependency and
      no Java in this project.
    -->
    <style name="RuxTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">false</item>
        <!--
          **The window stays inside the system bars**, which on Android is what `targetSdk = 34` gets by
          default and is why the manifest does not ask for `shortEdges`.

          It was written the other way first — edge to edge, with the application keeping its own content
          clear of the bars the way it does on iOS — and that does not work here. On iOS `egui-winit`
          reads `UIWindow.safeAreaInsets` and hands it to egui; there is no Android arm of that file at
          all, so the only reading available to a `NativeActivity` is `ANativeActivity`'s content rect,
          and **once edge to edge is enforced that rect is the whole window.** Measured on the emulator:
          `content rect Rect { left: 0, top: 0, right: 1080, bottom: 2400 } in a 1080x2400 px window`,
          with the nav strip drawn underneath the status bar as a result.

          The real insets are behind `View.getRootWindowInsets`, which is a JNI call that has to run on
          the Android UI thread while `android_main` is on its own. That is a ticket of its own; until
          then the window is the safe area, which is correct rather than approximate.
        -->
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
