<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The application draws every pixel of its own window, including the background behind the status bar
      and the navigation bar, so the system must not draw a title bar or an action bar over it.

      The parent is AppCompat's because `GameActivity` extends `AppCompatActivity`, which refuses to start
      under any other theme.

      **The window is edge to edge.** It used to stay inside the system bars, because a `NativeActivity`
      could not find out what the bars covered: `egui-winit` reads safe area insets on iOS only, and once
      Android enforces edge to edge `ANativeActivity`'s content rect is the whole window (measured on the
      emulator: `Rect { left: 0, top: 0, right: 1080, bottom: 2400 }` in a 1080x2400 px window). Now
      `RuxActivity.onApplyWindowInsets` reports the real insets and `rux` keeps the content clear of them.
    -->
    <style name="RuxTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
